Dialogue: 0,0:00:00.00,0:00:04.50,Default,,0,0,0,,Câu mười sáu: bình nước hình lăng trụ tam\Ngiác, đặt cạnh xuống dưới, mặt trên nằm ngang.
Dialogue: 0,0:00:04.50,0:00:09.00,Default,,0,0,0,,Nhiệt độ tăng bậc nhất theo độ cao: đáy\Nbốn độ C, mặt trên mười ba độ C.
Dialogue: 0,0:00:09.00,0:00:12.00,Default,,0,0,0,,Thành và nắp không dẫn\Nnhiệt, không hấp thụ nhiệt.
Dialogue: 0,0:00:12.00,0:00:15.00,Default,,0,0,0,,Sau đó nước có nhiệt độ\Nđều t không. Tìm t không.
Dialogue: 0,0:00:15.00,0:00:18.50,Default,,0,0,0,,Phân tích đề: thành và nắp\Nkhông dẫn nhiệt, không hấp thụ nhiệt,
Dialogue: 0,0:00:18.50,0:00:21.50,Default,,0,0,0,,nên nhiệt chỉ truyền giữa\Ncác lớp nước với nhau.
Dialogue: 0,0:00:21.50,0:00:24.00,Default,,0,0,0,,Vậy tổng nhiệt lượng\Ncủa nước được bảo toàn.
Dialogue: 0,0:00:24.00,0:00:28.00,Default,,0,0,0,,Lớp lạnh ở dưới thu nhiệt,\Nlớp nóng ở trên toả nhiệt.
Dialogue: 0,0:00:28.00,0:00:32.00,Default,,0,0,0,,Ý tưởng: chia nước thành các lớp mỏng,\Ntính nhiệt lượng từng lớp rồi cộng lại.
Dialogue: 0,0:00:32.00,0:00:35.00,Default,,0,0,0,,Bước một. Gọi h là độ\Ncao tính từ đỉnh dưới cùng.
Dialogue: 0,0:00:35.00,0:00:39.00,Default,,0,0,0,,t tăng bậc nhất theo h: t\Ncủa h bằng a nhân h cộng b.
Dialogue: 0,0:00:39.00,0:00:43.00,Default,,0,0,0,,Tại h bằng không, t bằng bốn\Nđộ C, suy ra b bằng bốn.
Dialogue: 0,0:00:43.00,0:00:47.00,Default,,0,0,0,,Tại h bằng H, t bằng mười\Nba, suy ra a bằng chín trên H.
Dialogue: 0,0:00:47.00,0:00:54.00,Default,,0,0,0,,Vậy t của h bằng bốn cộng chín h trên H.\NĐây là nhiệt độ của lớp nước ở độ cao h.
Dialogue: 0,0:00:54.00,0:00:58.50,Default,,0,0,0,,Bước hai. Lớp mỏng dày dh ở\Nđộ cao h có bề rộng x.
Dialogue: 0,0:00:58.50,0:01:02.00,Default,,0,0,0,,Hai tam giác đồng dạng nên\Nx trên L bằng h trên H.
Dialogue: 0,0:01:02.00,0:01:05.50,Default,,0,0,0,,Suy ra x bằng L nhân h\Nchia H, L là bề rộng mặt trên.
Dialogue: 0,0:01:05.50,0:01:09.50,Default,,0,0,0,,dV bằng x nhân e-lờ nhân dh,\Nbằng L e-lờ trên H nhân h dh.
Dialogue: 0,0:01:09.50,0:01:14.00,Default,,0,0,0,,Nhân với khối lượng riêng rô, ta\Nđược dm bằng k nhân h nhân dh.
Dialogue: 0,0:01:14.00,0:01:20.00,Default,,0,0,0,,Trong đó k bằng rô L e-lờ trên H là hằng số.\NL là bề rộng mặt trên, e-lờ là chiều dài lăng trụ.
Dialogue: 0,0:01:20.00,0:01:24.00,Default,,0,0,0,,Bước ba. Mọi lớp đều là\Nnước nên cùng nhiệt dung riêng c.
Dialogue: 0,0:01:24.00,0:01:26.50,Default,,0,0,0,,Lớp khối lượng dm đi từ t đến t không,
Dialogue: 0,0:01:26.50,0:01:30.00,Default,,0,0,0,,nhận nhiệt lượng dQ bằng c\Nnhân dm nhân t không trừ t.
Dialogue: 0,0:01:30.00,0:01:32.50,Default,,0,0,0,,dQ lớn hơn không: lớp lạnh thu nhiệt.
Dialogue: 0,0:01:32.50,0:01:35.00,Default,,0,0,0,,dQ nhỏ hơn không: lớp nóng toả nhiệt.
Dialogue: 0,0:01:35.00,0:01:38.00,Default,,0,0,0,,Không mất nhiệt ra ngoài,\Nnên tổng nhiệt lượng bằng không.
Dialogue: 0,0:01:38.00,0:01:41.00,Default,,0,0,0,,Tích phân c nhân t không\Ntrừ t nhân dm bằng không.
Dialogue: 0,0:01:41.00,0:01:47.00,Default,,0,0,0,,Đưa t không ra ngoài, suy ra t không\Nbằng tích phân t dm chia tích phân dm.
Dialogue: 0,0:01:47.00,0:01:50.00,Default,,0,0,0,,Đây chính là nhiệt độ\Ntrung bình, tính theo khối lượng.
Dialogue: 0,0:01:50.00,0:01:52.50,Default,,0,0,0,,Bước bốn: tính mẫu số,\Ntức tổng khối lượng M.
Dialogue: 0,0:01:52.50,0:01:59.50,Default,,0,0,0,,Thay dm bằng k h dh, h chạy từ không đến H: M\Nbằng tích phân k h dh, bằng k nhân H bình trên hai.
Dialogue: 0,0:01:59.50,0:02:01.50,Default,,0,0,0,,Kiểm tra bằng hình học:
Dialogue: 0,0:02:01.50,0:02:05.50,Default,,0,0,0,,M bằng rô nhân nửa L H nhân\Ne-lờ, cũng bằng k H bình trên hai.
Dialogue: 0,0:02:05.50,0:02:10.00,Default,,0,0,0,,Một nửa L H chính là\Ndiện tích tiết diện tam giác.
Dialogue: 0,0:02:10.00,0:02:15.00,Default,,0,0,0,,Bước năm: tính tử số N bằng tích phân t\Ndm, thay t và dm bằng biểu thức ở trên.
Dialogue: 0,0:02:15.00,0:02:19.00,Default,,0,0,0,,Đưa k ra ngoài: k nhân tích phân\Nbốn h cộng chín h bình trên H.
Dialogue: 0,0:02:19.00,0:02:22.50,Default,,0,0,0,,Số hạng bốn h: tích phân\Nbốn h dh bằng hai H bình.
Dialogue: 0,0:02:22.50,0:02:26.00,Default,,0,0,0,,Số hạng chín h bình trên\NH: tích phân bằng ba H bình.
Dialogue: 0,0:02:26.00,0:02:32.00,Default,,0,0,0,,Vậy N bằng k nhân hai H bình cộng\Nba H bình, tức là năm k H bình.
Dialogue: 0,0:02:32.00,0:02:34.50,Default,,0,0,0,,Bước sáu: kết quả. t không bằng N chia M.
Dialogue: 0,0:02:34.50,0:02:38.00,Default,,0,0,0,,Hay năm k H bình chia\Ncho k H bình trên hai.
Dialogue: 0,0:02:38.00,0:02:40.00,Default,,0,0,0,,Kết quả: t không bằng mười độ C!
Dialogue: 0,0:02:40.00,0:02:46.00,Default,,0,0,0,,k và H triệt tiêu, nên kết quả\Nkhông phụ thuộc vào kích thước của bình.
Dialogue: 0,0:02:46.00,0:02:50.00,Default,,0,0,0,,Mẹo giải nhanh, không cần tích phân:\Nt không là trung bình theo khối lượng.
Dialogue: 0,0:02:50.00,0:02:53.00,Default,,0,0,0,,t bậc nhất nên trung\Nbình bằng t ở trọng tâm.
Dialogue: 0,0:02:53.00,0:02:56.00,Default,,0,0,0,,Trọng tâm tam giác cách\Nđỉnh dưới hai H trên ba.
Dialogue: 0,0:02:56.00,0:02:59.50,Default,,0,0,0,,t không bằng bốn cộng chín nhân\Nhai phần ba, bằng mười độ C.
Dialogue: 0,0:02:59.50,0:03:04.00,Default,,0,0,0,,Cách này đúng cho mọi dạng bình, chỉ\Ncần nhiệt độ bậc nhất theo độ cao.
Dialogue: 0,0:03:04.00,0:03:06.50,Default,,0,0,0,,Đáp án: t không bằng mười độ C.
Dialogue: 0,0:03:06.50,0:03:10.00,Default,,0,0,0,,Lưu lại và follow để xem\Nthêm bài giải Vật lí mỗi ngày!
