rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ĐỔI email bên dưới thành tài khoản Google của bạn (trùng OWNER_EMAIL trong firebase-config.js)
    function isOwner() {
      return request.auth != null
        && request.auth.token.email == "baominh2627@gmail.com"
        && request.auth.token.email_verified == true;
    }
    match /{document=**} {
      allow read, write: if isOwner();
    }
  }
}
