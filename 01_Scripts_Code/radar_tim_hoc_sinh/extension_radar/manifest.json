{
  "manifest_version": 3,
  "name": "Radar Tìm Học Sinh — Canh Nhóm FB v3",
  "version": "3.2.0",
  "description": "Tích chọn các Group Tìm Gia Sư ngon nhất, tự canh bài mới nhất (kể cả bài chữ to/nền màu) và dẫn thẳng tới bài kèm bình luận soạn sẵn.",
  "permissions": ["storage", "alarms", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "https://www.facebook.com/*",
    "https://web.facebook.com/*"
  ],
  "action": {
    "default_title": "Radar Tìm Học Sinh v3",
    "default_popup": "popup.html"
  },
  "options_page": "groups.html",
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.facebook.com/*", "https://web.facebook.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
